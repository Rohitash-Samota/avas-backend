      "Bash(lsof -iTCP:8090 -sTCP:LISTEN -P -n)",
      "Bash(curl -s -w \"\\\\nHTTP:%{http_code}\\\\n\" http://0.0.0.0:8090/actuator/health --max-time 5)",
      "Bash(curl -s -w \"\\\\nHTTP:%{http_code}\\\\n\" http://[::1]:8090/actuator/health --max-time 5)",
      "Bash(docker rm *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:8080/actuator/health)",
      "Bash(curl -s http://localhost:8080/actuator/health)"
